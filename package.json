{
  "name": "edge-live-coach",
  "version": "1.0.0",
  "description": "Biomechanical AI Live-Coach with Dual-Agent Edge/Cloud Architecture (WebGPU 60Hz + Cloud LLM) and Zero-Media Privacy",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "biomechanics",
    "pose-estimation",
    "mediapipe",
    "webgpu",
    "edge-ai",
    "zero-media-privacy",
    "accessibility",
    "sports-coaching",
    "typescript"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:backend": "tsx backend/server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:ui": "vitest run tests/ui"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "ws": "^8.22.0"
  }
}
